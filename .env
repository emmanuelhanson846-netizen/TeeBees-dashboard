# Copy this file to ".env" and fill in your own app credentials.
# NEVER share .env or the data/ folder — they contain secrets and your login tokens.

PORT=5173
# How often to check your accounts for new activity (seconds, minimum 60)
POLL_SECONDS=120

# If Instagram/TikTok refuse "http://localhost" as a redirect URL, run an HTTPS
# tunnel (e.g. `cloudflared tunnel --url http://localhost:5173`) and put its URL here:
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

# ── Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, type: Web application) ──
# Authorized redirect URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Instagram (Meta developer app → "Instagram API with Instagram Login") ──
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: a token from the Meta dashboard's "Generate token" button. After signing in,
# go to Accounts → Instagram → Paste token → "Use token from .env" (or paste it straight into the page)
INSTAGRAM_ACCESS_TOKEN=

# ── TikTok (developers.tiktok.com → your app → Login Kit + Display API) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
